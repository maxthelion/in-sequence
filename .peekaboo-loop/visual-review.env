# Visual review recipe for roadmap item 4: Mixer Main Out.

SCENARIO_NAME="roadmap-4-mixer-main-out"
APP_NAME="${VISUAL_REVIEW_APP_NAME:-SequencerAI}"
PEEKABOO_BIN="${PEEKABOO_BIN:-./scripts/visual-scenarios/peekaboo-no-remote.sh}"
OUTPUT_ROOT=".claude/state/visual-review"
APP_PATH_COMMAND="scripts/open-latest-build.sh --print"
PRODUCT_PATHS="Sources Tests SequencerAI.xcodeproj Package.swift docs/roadmap/mixer-main-out"
SEQUENCER_AI_NEW_DOCUMENT_FIXTURE="${SEQUENCER_AI_NEW_DOCUMENT_FIXTURE:-$PWD/docs/roadmap/mixer-main-out/fixtures/mixer-main-out-live-meter.seqai}"
ApplePersistenceIgnoreState=YES
REFERENCE_PROTOTYPE="docs/roadmap/mixer-main-out/prototypes/mixer-main-out-variant-a.html"
REFERENCE_REVIEW="docs/roadmap/mixer-main-out/ux-review.md"
BUILD_CONTEXT="Roadmap item 4: Mixer Main Out. Compare the built Master Out UI against the corrected post-blend master bus intent, docs/roadmap/mixer-main-out/spec.md, prototype-approval.md, ux-review.md, and the selected prototype. The reviewer should decide whether the user should see the build before renewed product-owner attention."
PRE_CAPTURE_SCRIPT="./scripts/visual-scenarios/mixer-main-out.sh"
