# Copy to a gitignored shell env file outside the repo, or to
# scripts/distribution.r2.env, before running package-developer-id.sh
# with --upload-r2. Never commit real credentials.
R2_DISTRIBUTION_BUCKET=in-seq-builds
R2_DISTRIBUTION_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_DISTRIBUTION_ACCESS_KEY_ID=replace-me
R2_DISTRIBUTION_SECRET_ACCESS_KEY=replace-me
R2_REGION=auto
R2_DISTRIBUTION_PREFIX=releases/developer-id
R2_DISTRIBUTION_LATEST_KEY=releases/developer-id/latest.json
# Optional, only if the bucket/object prefix is publicly served.
# R2_DISTRIBUTION_PUBLIC_BASE_URL=https://downloads.example.com
