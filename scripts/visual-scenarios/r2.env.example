# Copy to a gitignored shell env file outside the repo or export these in your
# shell before running r2-sync.sh / r2-fetch.sh. Never commit real credentials.
R2_BUCKET=ux-captures
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_REGION=auto
