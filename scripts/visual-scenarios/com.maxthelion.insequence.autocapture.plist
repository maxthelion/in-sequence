<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maxthelion.insequence.autocapture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/maxwilliams/dev/in-sequence/scripts/visual-scenarios/auto-capture-watch.sh</string>
    </array>

    <!-- Fire every 5 minutes. The script is cheap when nothing is stale. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Keep PATH sane for xcodebuild / peekaboo when launchd spawns us. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/maxwilliams/dev/in-sequence/.meta/multipass/visual-review/.auto-capture.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxwilliams/dev/in-sequence/.meta/multipass/visual-review/.auto-capture.err.log</string>
</dict>
</plist>
